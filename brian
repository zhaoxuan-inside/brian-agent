#!/usr/bin/env bash
# ============================================================================
# brian — Brian-Agent 系统管理命令行工具（跨平台薄壳）
#
# 实际实现统一收敛在 scripts/brian-cli.mjs（Node 跨平台，Linux/macOS/Windows 同一套逻辑）。
# Windows 原生入口：brian.cmd；WSL / Git Bash 亦可直接使用本脚本。
#
# 用法: ./brian <command> [service] [flags]   （详见 ./brian --help）
# ============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"

exec node "$SCRIPT_DIR/scripts/brian-cli.mjs" "$@"
