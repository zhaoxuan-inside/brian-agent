#!/usr/bin/env bash
# ============================================================================
# brian — Brian-Agent 系统管理命令行工具
#
# 参考 OpenCode CLI 的启动/关闭方式设计，提供前台（dev/serve）与后台（start/stop）
# 两种运行模式，并支持 -h/--help、-v/--version 全局参数。
#
# 用法: brian <command> [service] [flags]
#
# 命令:
#   start   [backend|frontend|all]  后台启动服务（默认 all）
#   stop    [backend|frontend|all]  停止服务（默认 all）
#   restart [backend|frontend|all]  重启服务
#   status                          查看运行状态
#   logs    [backend|frontend]      跟踪日志（默认 backend）
#   serve                          前台启动后端服务（headless，Ctrl+C 停止）
#   dev                             前台启动全栈开发模式（后端+前端，Ctrl+C 一键停止）
#   open                            在默认浏览器打开前端页面
#   doctor                          环境与依赖自检
#   clean                           清理日志文件与 PID 残留
#
# 全局参数:
#   -h, --help                      显示帮助
#   -v, --version                   显示版本号
#
# 示例:
#   brian start              # 后台启动全栈
#   brian start backend      # 后台仅启动后端
#   brian dev                # 前台开发模式，Ctrl+C 一键关闭
#   brian serve              # 前台启动 headless 后端
#   brian open               # 浏览器打开前端
#   brian doctor             # 环境自检
#   brian stop               # 停止全栈
#   brian logs backend       # 查看后端日志
# ============================================================================

set -e

# 解析脚本的真实路径（处理符号链接）
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
BACKEND_DIR="$ROOT/brian-backend"
FRONTEND_DIR="$ROOT/brian-frontend"
BACKEND_PORT="${BRIAN_PORT:-8000}"
FRONTEND_PORT=5173
# CDT（浏览器自动化）自动启动默认关闭：省一个常驻 Chrome（~400-600MB），低内存开发机建议保持
# 需要浏览器自动化时设 BRIAN_CDT_AUTO=1，或启动后在 /tool 页手动启动 CDT
export BRIAN_CDT_AUTO="${BRIAN_CDT_AUTO:-0}"

BACKEND_LOG="/tmp/brian-backend.log"
FRONTEND_LOG="/tmp/brian-frontend.log"
BACKEND_PID_FILE="/tmp/brian-backend.pid"
FRONTEND_PID_FILE="/tmp/brian-frontend.pid"

# 版本号（从根 package.json 读取，失败时回退）
VERSION="$(node -p "require('$ROOT/package.json').version" 2>/dev/null || echo "1.0.0")"

# ---------------------------------------------------------------------------
# 颜色
# ---------------------------------------------------------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; NC='\033[0m'; BOLD='\033[1m'

log()  { echo -e "${BLUE}[brian]${NC} $1"; }
ok()   { echo -e "       ${GREEN}✓${NC} $1"; }
warn() { echo -e "       ${YELLOW}⚠${NC} $1"; }
fail() { echo -e "       ${RED}✗${NC} $1"; }

banner() {
  echo ""
  echo -e "  ${BOLD}Brian-Agent${NC}  v$VERSION"
  echo -e "  Intelligent Personal Assistant"
  echo ""
}

# ---------------------------------------------------------------------------
# 进程检测
# ---------------------------------------------------------------------------

# 通过端口检测后端是否存活
backend_alive() {
  curl --noproxy "*" --connect-timeout 2 -m 3 -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:$BACKEND_PORT/api/config/soul" 2>/dev/null | grep -q "200"
  return $?
}

# 通过端口检测前端是否存活
frontend_alive() {
  curl --noproxy "*" --connect-timeout 2 -m 3 -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:$FRONTEND_PORT" 2>/dev/null | grep -q "200\|302\|304"
  return $?
}

# 获取后端 PID（多种方式检测）
backend_pid() {
  if [ -f "$BACKEND_PID_FILE" ]; then
    local pid=$(cat "$BACKEND_PID_FILE" 2>/dev/null)
    if kill -0 "$pid" 2>/dev/null; then echo "$pid"; return; fi
  fi
  pgrep -f "tsx.*dev-server" 2>/dev/null | head -1
}

# 获取前端 PID
frontend_pid() {
  if [ -f "$FRONTEND_PID_FILE" ]; then
    local pid=$(cat "$FRONTEND_PID_FILE" 2>/dev/null)
    if kill -0 "$pid" 2>/dev/null; then echo "$pid"; return; fi
  fi
  pgrep -f "node.*vite" 2>/dev/null | head -1
}

# ---------------------------------------------------------------------------
# start_backend
# ---------------------------------------------------------------------------
start_backend() {
  if backend_alive; then
    warn "后端已运行 (端口 $BACKEND_PORT, PID $(backend_pid))"
    return
  fi

  fuser -k "$BACKEND_PORT/tcp" 2>/dev/null || true
  sleep 0.5

  log "启动后端..."
  if [ ! -d "$BACKEND_DIR" ]; then
    fail "后端目录不存在: $BACKEND_DIR"
    exit 1
  fi

  cd "$BACKEND_DIR"
  nohup npx tsx dev-server.ts >> "$BACKEND_LOG" 2>&1 &
  echo $! > "$BACKEND_PID_FILE"

  # 等待就绪（最多 120 秒）
  for i in $(seq 1 60); do
    sleep 2
    if backend_alive; then
      ok "后端就绪 (端口 $BACKEND_PORT, PID $(cat $BACKEND_PID_FILE))"
      return
    fi
    if ! kill -0 "$(cat $BACKEND_PID_FILE)" 2>/dev/null; then
      fail "后端进程启动失败，查看日志: brian logs backend"
      exit 1
    fi
  done
  warn "后端启动超时，可能仍在初始化中 (PID $(cat $BACKEND_PID_FILE))"
}

# ---------------------------------------------------------------------------
# start_frontend
# ---------------------------------------------------------------------------
start_frontend() {
  if frontend_alive; then
    warn "前端已运行 (端口 $FRONTEND_PORT, PID $(frontend_pid))"
    return
  fi

  log "启动前端..."
  if [ ! -d "$FRONTEND_DIR" ]; then
    fail "前端目录不存在: $FRONTEND_DIR"
    exit 1
  fi

  cd "$FRONTEND_DIR"
  nohup npx vite --host 0.0.0.0 >> "$FRONTEND_LOG" 2>&1 &
  echo $! > "$FRONTEND_PID_FILE"

  for i in $(seq 1 15); do
    sleep 2
    if frontend_alive; then
      ok "前端就绪 (端口 $FRONTEND_PORT, PID $(cat $FRONTEND_PID_FILE))"
      return
    fi
  done
  warn "前端启动超时 (PID $(cat $FRONTEND_PID_FILE))"
}

# ---------------------------------------------------------------------------
# stop_backend
# ---------------------------------------------------------------------------
stop_backend() {
  local pid=$(backend_pid)
  if [ -n "$pid" ] || fuser "$BACKEND_PORT/tcp" >/dev/null 2>&1; then
    log "停止后端 (PID ${pid:-端口 $BACKEND_PORT})..."
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    sleep 1
    # 强制杀掉残留与端口占用
    [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true
    pkill -f "tsx.*dev-server" 2>/dev/null || true
    fuser -k "$BACKEND_PORT/tcp" 2>/dev/null || true
    rm -f "$BACKEND_PID_FILE"
    ok "后端已停止"
  else
    warn "后端未运行"
  fi
}

# ---------------------------------------------------------------------------
# stop_frontend
# ---------------------------------------------------------------------------
stop_frontend() {
  local pid=$(frontend_pid)
  if [ -n "$pid" ] || fuser "$FRONTEND_PORT/tcp" >/dev/null 2>&1; then
    log "停止前端 (PID ${pid:-端口 $FRONTEND_PORT})..."
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    sleep 1
    [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true
    pkill -f "node.*vite" 2>/dev/null || true
    fuser -k "$FRONTEND_PORT/tcp" 2>/dev/null || true
    rm -f "$FRONTEND_PID_FILE"
    ok "前端已停止"
  else
    warn "前端未运行"
  fi
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
show_status() {
  banner
  echo -e "  ${BOLD}后端${NC} (端口 $BACKEND_PORT)"
  if backend_alive; then
    local bpid=$(backend_pid)
    echo -e "    状态: ${GREEN}运行中${NC}   PID: ${bpid:-?}"
    echo -e "    地址: http://127.0.0.1:$BACKEND_PORT"
  else
    echo -e "    状态: ${RED}已停止${NC}"
  fi

  echo ""
  echo -e "  ${BOLD}前端${NC} (端口 $FRONTEND_PORT)"
  if frontend_alive; then
    local fpid=$(frontend_pid)
    echo -e "    状态: ${GREEN}运行中${NC}   PID: ${fpid:-?}"
    echo -e "    地址: http://127.0.0.1:$FRONTEND_PORT"
  else
    echo -e "    状态: ${RED}已停止${NC}"
  fi
  echo ""
}

# ---------------------------------------------------------------------------
# logs
# ---------------------------------------------------------------------------
show_logs() {
  local service="${1:-backend}"
  local log_file
  case "$service" in
    backend)  log_file="$BACKEND_LOG" ;;
    frontend) log_file="$FRONTEND_LOG" ;;
    *) fail "未知服务: $service (backend|frontend)"; exit 1 ;;
  esac

  if [ ! -f "$log_file" ]; then
    warn "日志文件不存在: $log_file"
    exit 1
  fi
  tail -f "$log_file"
}

# ---------------------------------------------------------------------------
# serve — 前台启动 headless 后端（对标 `opencode serve`）
# ---------------------------------------------------------------------------
serve_backend() {
  if backend_alive; then
    warn "后端已运行 (端口 $BACKEND_PORT)，无需重复启动"
    return
  fi
  if [ ! -d "$BACKEND_DIR" ]; then
    fail "后端目录不存在: $BACKEND_DIR"
    exit 1
  fi
  banner
  log "前台启动后端服务 (headless)，端口 $BACKEND_PORT —— 按 Ctrl+C 停止"
  cd "$BACKEND_DIR"
  exec npx tsx dev-server.ts
}

# ---------------------------------------------------------------------------
# dev — 前台启动全栈开发模式（对标 `opencode` 的 TUI 前台模式）
# ---------------------------------------------------------------------------
dev_all() {
  banner
  log "前台启动全栈开发模式（后端 + 前端）—— 按 Ctrl+C 一键停止"
  (cd "$BACKEND_DIR" && npx tsx dev-server.ts) &
  local bpid=$!
  (cd "$FRONTEND_DIR" && npx vite --host 0.0.0.0) &
  local fpid=$!

  trap 'echo ""; log "正在停止服务..."; kill "$bpid" "$fpid" 2>/dev/null || true; wait 2>/dev/null || true; ok "已停止"; exit 0' INT TERM

  # 提示前端访问地址
  ( sleep 3; echo ""; log "前端访问: http://127.0.0.1:$FRONTEND_PORT  ·  后端 API: http://127.0.0.1:$BACKEND_PORT" ) &
  local hint_pid=$!
  wait
  kill "$hint_pid" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# open — 在默认浏览器打开前端
# ---------------------------------------------------------------------------
open_browser() {
  local url="http://127.0.0.1:$FRONTEND_PORT"
  if ! frontend_alive; then
    warn "前端未运行，先启动前端..."
    start_frontend
  fi
  log "打开浏览器: $url"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  elif command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 || true
  elif command -v start >/dev/null 2>&1; then
    start "$url" >/dev/null 2>&1 || true
  else
    warn "无法自动打开浏览器，请手动访问 $url"
  fi
}

# ---------------------------------------------------------------------------
# doctor — 环境与依赖自检
# ---------------------------------------------------------------------------
doctor() {
  banner
  log "环境与依赖自检"

  echo ""
  echo -e "  ${BOLD}基础环境${NC}"
  for c in node npm npx; do
    if command -v "$c" >/dev/null 2>&1; then
      ok "$c: $(command -v "$c")"
    else
      fail "$c 未安装"
    fi
  done

  echo ""
  echo -e "  ${BOLD}项目目录${NC}"
  [ -d "$BACKEND_DIR" ]   && ok "后端目录存在: $BACKEND_DIR"   || fail "后端目录缺失: $BACKEND_DIR"
  [ -d "$FRONTEND_DIR" ]  && ok "前端目录存在: $FRONTEND_DIR"  || fail "前端目录缺失: $FRONTEND_DIR"
  [ -d "$ROOT/node_modules" ] && ok "根 node_modules 存在"     || warn "根 node_modules 缺失，请运行 npm install"
  [ -d "$ROOT/data" ]     && ok "数据目录存在: $ROOT/data"     || warn "数据目录缺失，首次启动会自动生成"

  echo ""
  echo -e "  ${BOLD}端口占用${NC}"
  if backend_alive;  then ok "后端端口 $BACKEND_PORT 正在服务（已运行）";  else ok "后端端口 $BACKEND_PORT 空闲"; fi
  if frontend_alive; then ok "前端端口 $FRONTEND_PORT 正在服务（已运行）"; else ok "前端端口 $FRONTEND_PORT 空闲"; fi

  echo ""
  echo -e "  ${BOLD}原生依赖 (prebuilt)${NC}"
  local prebuilt_ok=0
  for f in better-sqlite3 isolated-vm lancedb; do
    if [ -d "$ROOT/brian-backend/prebuilt/$f" ]; then
      ok "prebuilt/$f 存在"
    else
      fail "prebuilt/$f 缺失"
      prebuilt_ok=1
    fi
  done
  [ "$prebuilt_ok" -eq 0 ] && ok "原生依赖就绪" || warn "请运行 npm install 触发 postinstall 拷贝 prebuilt"
  echo ""
}

# ---------------------------------------------------------------------------
# clean — 清理日志与 PID 残留
# ---------------------------------------------------------------------------
clean() {
  log "清理日志文件与 PID 残留"
  local n=0
  for f in "$BACKEND_LOG" "$FRONTEND_LOG" "$BACKEND_PID_FILE" "$FRONTEND_PID_FILE"; do
    if [ -f "$f" ]; then rm -f "$f"; n=$((n+1)); fi
  done
  ok "已清理 $n 个文件"
}

# ---------------------------------------------------------------------------
# 帮助
# ---------------------------------------------------------------------------
usage() {
  echo "Brian-Agent v$VERSION — 系统管理命令行工具"
  echo ""
  echo "用法: brian <command> [service] [flags]"
  echo ""
  echo "命令:"
  echo "  start   [backend|frontend|all]  后台启动服务（默认 all）"
  echo "  stop    [backend|frontend|all]  停止服务（默认 all）"
  echo "  restart [backend|frontend|all]  重启服务"
  echo "  status                          查看运行状态"
  echo "  logs    [backend|frontend]      跟踪日志（默认 backend）"
  echo "  serve                           前台启动后端服务（headless，Ctrl+C 停止）"
  echo "  dev                              前台启动全栈开发模式（Ctrl+C 一键停止）"
  echo "  open                             在默认浏览器打开前端页面"
  echo "  doctor                           环境与依赖自检"
  echo "  clean                            清理日志文件与 PID 残留"
  echo ""
  echo "全局参数:"
  echo "  -h, --help                       显示帮助"
  echo "  -v, --version                    显示版本号"
  echo ""
  echo "示例:"
  echo "  brian start              # 后台启动全栈"
  echo "  brian start backend      # 后台仅启动后端"
  echo "  brian dev                # 前台开发模式，Ctrl+C 一键关闭"
  echo "  brian serve              # 前台启动 headless 后端"
  echo "  brian open               # 浏览器打开前端"
  echo "  brian doctor             # 环境自检"
  echo "  brian logs backend       # 查看后端日志"
  exit 0
}

# ---------------------------------------------------------------------------
# 主入口
# ---------------------------------------------------------------------------
# 解析全局 flags
case "${1:-}" in
  -h|--help|help)   usage ;;
  -v|--version|version) echo "Brian-Agent v$VERSION"; exit 0 ;;
esac

CMD="${1:-status}"
SVC="${2:-all}"

case "$CMD" in
  start)
    case "$SVC" in
      backend)  banner; start_backend ;;
      frontend) banner; start_frontend ;;
      all)      banner; start_backend; echo ""; start_frontend ;;
      *) usage ;;
    esac
    ;;
  stop)
    case "$SVC" in
      backend)  stop_backend ;;
      frontend) stop_frontend ;;
      all)      stop_backend; stop_frontend ;;
      *) usage ;;
    esac
    ;;
  restart)
    case "$SVC" in
      backend)  stop_backend; sleep 1; start_backend ;;
      frontend) stop_frontend; sleep 1; start_frontend ;;
      all)      stop_backend; stop_frontend; sleep 1
                banner; start_backend; echo ""; start_frontend ;;
      *) usage ;;
    esac
    ;;
  status)
    show_status
    ;;
  logs)
    show_logs "$SVC"
    ;;
  serve)
    serve_backend
    ;;
  dev)
    dev_all
    ;;
  open)
    open_browser
    ;;
  doctor)
    doctor
    ;;
  clean)
    clean
    ;;
  *)
    usage
    ;;
esac
