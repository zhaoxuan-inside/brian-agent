		{"id":"a28ec504fb75becf","type":"text","text":"Chat","x":-312,"y":-720,"width":182,"height":60},
		{"id":"19133316987a0c5e","type":"text","text":"Strategy","x":-560,"y":-280,"width":180,"height":60},
		{"id":"d4e09678ba898339","type":"text","text":"Core","x":-560,"y":-140,"width":180,"height":60},
