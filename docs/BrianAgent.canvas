		{"id":"10ff899b2a319a6d","type":"text","text":"Access","x":-558,"y":-720,"width":180,"height":60},
		{"id":"148f82121741a56e","x":232,"y":180,"width":196,"height":80,"type":"text","text":"对 sqlite 等数据库的封装方便替换"},
		{"id":"6c65df273145b196","x":428,"y":180,"width":196,"height":80,"type":"text","text":"对 TinyGraphDB 等图数据库的封装方便替换"},
		{"id":"c9d332595f4cab11","x":624,"y":180,"width":196,"height":80,"type":"text","text":"对消息队列的封装，现在使用 SQLite 实现消息队列"},
		{"id":"b5f5117405b73715","type":"text","text":"向量数据库封装器","x":820,"y":-14,"width":196,"height":60},
		{"id":"8665295f8d3ea786","x":820,"y":183,"width":196,"height":77,"type":"text","text":"对向量数据据的封装方便替换"},
		{"id":"6a5acabec72579d1","type":"text","text":"对 MCP 的管理，支持配置 MCP 市场从市场中获取 MCP 的配置详情，并进行安装，并对安装到本地的 MCP 进行管理，配置，删除，添加等","x":-84,"y":130,"width":225,"height":180},
		{"id":"972fb498bb7a0cce","x":-214,"y":410,"width":213,"height":180,"type":"text","text":"封装不同 LLM 模型厂商的各类模型，包括但不限于 Embedding，chat，语言，图片和视频模型"},
		{"id":"af0a80b4778c8757","type":"text","text":"对 Skill 的管理，以及对 Skill 安装的抽象，根据内部学习的知识生成 Skill，也支持从外部手动创建，以及根据教程自动创建 Skill","x":52,"y":410,"width":225,"height":180},
		{"id":"e1873f192834a975","x":-349,"y":133,"width":210,"height":177,"type":"text","text":"管理不同层次的策略，支持从外部导入策略，以及根据用户使用体验在默认策略的基础上自动开发新策略"},
		{"id":"e93072bd27489277","x":-1040,"y":-14,"width":250,"height":60,"type":"text","text":"基础构件层，负责构建，管理基础的能力"},
		{"id":"8f3d7650d2e491bd","x":-1300,"y":-350,"width":510,"height":220,"type":"text","text":"策略层\n根据基础层提供的能力封装成一个完整的 Agent；\n思考策略：用来指导思考的过程模式为 ReACT 模型； \\[必须\\]\nMCP：外部 MCP 能力；\nSkill：处理指定功能的 Skill 技能；\nLLM：Agent 的大脑；  \\[必须\\]\nWork：处理一个具体事情的处理手册，是可以直接落地的方案；\nInfo：用户的各种类型的记忆，自学习学到的知识"},
		{"id":"b2a5be38bae11d92","x":-1300,"y":-520,"width":510,"height":170,"type":"text","text":"解决方案层\n负责承接来自上层的任务，并对任务进行分解，编排将任务分解为不可再分的原子任务后交给具体的 Agent 进行处理\nAgent 编排：为 Agent 任务编排分析的策略，借鉴 OpenClaw，Hermes，OpenHuman，LangChain 对任务的分解，编排，执行方面的技巧"},
		{"id":"77af8f5a990d4833","x":-1300,"y":-690,"width":510,"height":170,"type":"text","text":"应用层\n也就是 BrianAgent 的任务的来源\n自学习策略：根据自学习策略采集，规划，管理要学习的内容；\nChat：接受来自用户的 Chat 请求\n用户肖像任务：对用户的使用历史进行分析，分析用户的喜好，优化对用户输入的理解和对输出的指导。"},
		{"id":"3b33a4cfb398d2d3","x":-346,"y":-1080,"width":250,"height":60,"type":"text","text":"Web 上面 chat 的方式"},
		{"id":"8d5516428fc29041","x":-165,"y":-967,"width":250,"height":60,"type":"text","text":"支持 IM 接入的 Gateway"},
		{"id":"ec397cc72f632730","x":14,"y":-1080,"width":250,"height":60,"type":"text","text":"配置管理器，负责配置的管理和展示"},
		{"id":"8d5678f73de53647","x":189,"y":-967,"width":250,"height":167,"type":"text","text":"负责整个系统各类数据的统计监控。例如：宿主机系统资源（CPU，内存，磁盘），模型（token 用量，首 token 耗时，模型调用次数）等整个系统指标的监控"},
		{"id":"b714bbc84b009050","x":335,"y":-1092,"width":250,"height":92,"type":"text","text":"这是一个 Multi-Agent 系统，要有整个流程可视化手段"},
		{"id":"c650900faf40b45c","x":475,"y":-967,"width":250,"height":107,"type":"text","text":"反馈系统，用于收集用户在使用过程中的报错以及体验上面的数据，并进行上报"},
		{"id":"cc0ac51594addf70","x":1080,"y":-150,"width":380,"height":80,"type":"text","text":"通常说的 memory，主要负责屏蔽底层的各种数据库，并提供合适的数据给调用方"},
		{"id":"d03d592d45265f67","x":-1040,"y":-110,"width":250,"height":60,"type":"text","text":"基础层，负责管理构建 Agent 所需要的能力"},
		{"id":"11449f315f57b134","x":1080,"y":-780,"width":580,"height":250,"type":"text","text":"非常重要，Agent 是解决用户任务的最基本单位\nAgent 是由策略，mcp，llm，Skill，Soul，work 等部分构成的\nAgent 的产生有四种方式：\n1. 系统没有合适的 Agent 则，由系统构建一个 Agent，来执行任务；\n2. 经过用户的使用产生用户常用的功能的 Agent；\n3. 经过自学习产生的 Agent；\n4. 用户通过配置中心手动创建的 Agent 并绑定各种需要的工具；"},
		{"id":"01600bdc4ae4247f","x":1080,"y":-500,"width":580,"height":90,"type":"text","text":"Soul，Agent 针对某一类任务的独特品质，例如：律师 Agent：一定要严谨；开发工程师：要求可以 work 并且通过流程图的形式展示代码"},
		{"id":"33b03c9f0a2d6a52","x":1080,"y":-380,"width":420,"height":100,"type":"text","text":"Skill：是对一类任务的处理流程；例如：第一步调用接口；第二部分析接口响应内容；"},
		{"id":"0db3e16b05ab1ad8","x":1080,"y":-270,"width":380,"height":100,"type":"text","text":"Work：对一个具体的事情的处理流程。例如：第一步：打开文件夹；第二步：查找 xxx 这个文件；第三步，重命名为 yyy"},
		{"id":"5ad727f9e4ff5cf0","x":-888,"y":-988,"width":510,"height":163,"type":"text","text":"AgentPlan 是用来编排任务的 Agent，这个 Agent 既不是一类 Agent，也不是一个 Agent，它是很多类且很多个 Agent，某一类 Agent 用来处理一类任务的 plan，plan 的过程中还需要进行递归或者子任务拆解派发，最后再汇总"}
	],
